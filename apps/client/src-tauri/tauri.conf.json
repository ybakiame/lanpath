{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lanpath",
  "version": "0.1.2-beta.1",
  "identifier": "com.ybakiame.lanpath",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "岚径 · Lanpath",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZERkQzQjQyQUQxNDE5RjcKUldUM0dSU3RRanY5L2E0R1VjbUNNZXhnbUZlZVBxWVM4NFhNaTZxYlkzM1VsUGlBN0dyVDVQc28K",
      "endpoints": [
        "https://github.com/ybakiame/lanpath/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
